PROJECT_NAME="NER CognitiveCare Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL / SQLite fallback for local test without docker)
DATABASE_URL="sqlite:///./ner_cognitivecare.db"
# For production PostgreSQL: postgresql://postgres:postgres@localhost:5432/ner_cognitivecare

# Security & JWT
JWT_SECRET="ner-cognitivecare-super-secure-production-jwt-secret-key-change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379/0"

# CORS Configuration
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"

# AI Service Configuration
AI_PROVIDER="rule_based"
AI_API_KEY=""
